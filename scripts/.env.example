# TMDB API key (free at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Comma-separated paths to your movie and series roots
MOVIES_ROOTS=/mnt/drive1/movies,/mnt/drive2/movies
SERIES_ROOTS=/mnt/drive1/series,/mnt/drive2/series

# Plex RSS watchlist URLs (comma-separated)
# Get yours from https://app.plex.tv/desktop/#!/settings/watchlist
RSS_URLS=https://rss.plex.tv/your-token-here
