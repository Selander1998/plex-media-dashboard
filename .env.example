# Optional: set a password to enable authentication on the dashboard
DASHBOARD_TOKEN=

QBIT_URL=http://YOUR_QBIT_HOST:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin
PORT=3000

# Comma-separated paths that qBittorrent saves completed torrents to
TORRENT_SAVE_PATHS=/mnt/drive1/torrents,/mnt/drive2/torrents

# Subfolder used as qBittorrent's incomplete-download temp folder (optional)
# e.g. "temp" → /mnt/drive1/torrents/temp, /mnt/drive2/torrents/temp
# Switching drives in the dashboard also updates qBittorrent's temp path
TORRENT_TEMP_SUBDIR=temp

# Absolute paths to the generated JSON files produced by scripts/update.sh
REPORT_PATH=/absolute/path/to/scripts/report.json
WATCHLIST_PATH=/absolute/path/to/scripts/watchlist.json

# Optional: Plex Media Server — leave blank to disable library refresh
PLEX_URL=http://YOUR_PLEX_HOST:32400
PLEX_TOKEN=
# Seconds to wait after triggering a Plex library scan before checking the index (default: 15)
PLEX_SCAN_WAIT=15

# Optional: ntfy push notifications — sent when a torrent completes
NTFY_URL=https://your-ntfy-server/your-topic
NTFY_USER=
NTFY_PASS=
